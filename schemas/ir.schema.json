{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lumensparkxy/google_adk_testing_automation/schemas/ir.schema.json",
  "title": "Plain-English Test Intermediate Representation",
  "description": "MVP1 JSON IR contract between validated structured specs and generated Playwright tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "spec",
    "environment",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseUrl"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "authStateRef": {
          "type": "string",
          "minLength": 1,
          "description": "Non-sensitive reference to managed auth state. This must not contain storage-state contents."
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "value"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "test_id",
            "role",
            "label",
            "text",
            "css"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "boolean"
        }
      },
      "dependentSchemas": {
        "exact": {
          "properties": {
            "strategy": {
              "enum": ["role", "text", "label"]
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "dataRowId": {
          "$ref": "#/$defs/identifier"
        },
        "resolvedData": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/navigateStep"
              },
              {
                "$ref": "#/$defs/fieldInputStep"
              },
              {
                "$ref": "#/$defs/clickStep"
              },
              {
                "$ref": "#/$defs/assertVisibleStep"
              },
              {
                "$ref": "#/$defs/assertLocatorContentStep"
              },
              {
                "$ref": "#/$defs/assertUrlStep"
              },
              {
                "$ref": "#/$defs/assertTitleStep"
              },
              {
                "$ref": "#/$defs/assertCheckedStep"
              },
              {
                "$ref": "#/$defs/assertEnabledStep"
              },
              {
                "$ref": "#/$defs/assertAttributeEqualsStep"
              },
              {
                "$ref": "#/$defs/assertCountStep"
              }
            ]
          }
        }
      }
    },
    "exactRadioLocator": {
      "required": ["role", "exact"],
      "properties": {
        "strategy": { "const": "role" },
        "role": { "const": "radio" },
        "exact": { "const": true }
      }
    },
    "stepBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceStepIndex",
        "original",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourceStepIndex": {
          "type": "integer",
          "minimum": 0
        },
        "original": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "expected": {
          "$ref": "#/$defs/scalar"
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "navigateStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "action": {
              "const": "navigate"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              }
            ]
          }
        }
      ]
    },
    "fieldInputStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "value"
          ],
          "properties": {
            "action": {
              "enum": ["fill", "fill_literal", "select_option", "set_checked"]
            }
          },
          "if": {
            "properties": {
              "action": { "enum": ["fill_literal", "select_option", "set_checked"] }
            }
          },
          "then": {
            "properties": {
              "locator": {
                "required": ["exact"],
                "properties": {
                  "strategy": { "const": "label" },
                  "exact": { "const": true }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "action": { "const": "fill_literal" } } },
              "then": { "properties": { "value": { "type": "string" } } }
            },
            {
              "if": { "properties": { "action": { "const": "select_option" } } },
              "then": { "properties": { "value": { "type": "string", "minLength": 1 } } }
            },
            {
              "if": { "properties": { "action": { "const": "set_checked" } } },
              "then": { "properties": { "value": { "type": "boolean" } } }
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              }
            ]
          }
        }
      ]
    },
    "clickStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "action": {
              "enum": ["click", "select_radio"]
            }
          },
          "if": { "properties": { "action": { "const": "select_radio" } } },
          "then": { "properties": { "locator": { "$ref": "#/$defs/exactRadioLocator" } } },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertVisibleStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "action": {
              "enum": ["assert_visible", "assert_hidden"]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertLocatorContentStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "expected"
          ],
          "properties": {
            "action": {
              "enum": [
                "assert_text_equals",
                "assert_scoped_text_equals",
                "assert_value_equals",
                "assert_value_contains"
              ]
            }
          },
          "if": {
            "properties": {
              "action": {
                "const": "assert_value_contains"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertUrlStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "action": {
              "const": "assert_url"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertTitleStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "expected"
          ],
          "properties": {
            "action": {
              "const": "assert_title"
            },
            "expected": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "attribute"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertCheckedStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "expected"
          ],
          "properties": {
            "action": {
              "enum": ["assert_checked", "assert_radio_selected"]
            },
            "expected": {
              "type": "boolean"
            }
          },
          "if": { "properties": { "action": { "const": "assert_radio_selected" } } },
          "then": { "properties": { "locator": { "$ref": "#/$defs/exactRadioLocator" } } },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "attribute"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertEnabledStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "expected"
          ],
          "properties": {
            "action": {
              "const": "assert_enabled"
            },
            "expected": {
              "type": "boolean"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "attribute"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertAttributeEqualsStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "attribute",
            "expected"
          ],
          "properties": {
            "action": {
              "const": "assert_attribute_equals"
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertCountStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "locator",
            "expected"
          ],
          "properties": {
            "action": {
              "const": "assert_count"
            },
            "expected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "attribute"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
