GEMINI_API_KEY=your_key_here
MODEL_NAME=gemini-3.5-flash

# Google Login (backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Optional: comma-separated allow-list for multiple frontend builds/environments.
# GOOGLE_CLIENT_IDS=your_local_client_id.apps.googleusercontent.com,your_prod_client_id.apps.googleusercontent.com
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Local/E2E compatibility mode. Production deployments must use firebase-only.
AUTH_TOKEN_MODE=firebase-or-backend-jwt
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional for local containerized backend auth or non-GCP runtimes.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional alternative for the deploy helper: absolute path to a local Firebase Admin SDK JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Optional dedicated encryption key for stored per-user JIRA connections.
# If unset, the backend will derive encryption from JWT_SECRET_KEY.
# JIRA_CONNECTION_SECRET_KEY=replace_with_a_different_long_random_secret
# Optional JIRA Cloud client tuning.
# JIRA_API_TIMEOUT_SECONDS=15
# JIRA_PROJECT_PAGE_SIZE=50
# JIRA_ISSUE_PAGE_SIZE=50

# Optional dedicated encryption key for stored per-user Azure DevOps connections.
# If unset, the backend will derive encryption from JWT_SECRET_KEY.
# AZURE_DEVOPS_CONNECTION_SECRET_KEY=replace_with_a_different_long_random_secret
# Optional Azure DevOps Services client tuning.
# AZURE_DEVOPS_API_TIMEOUT_SECONDS=15
# AZURE_DEVOPS_API_VERSION=7.1
# AZURE_DEVOPS_PROJECT_PAGE_SIZE=50
# AZURE_DEVOPS_WORK_ITEM_PAGE_SIZE=50

# Execution preview/run controls.
EXECUTION_ENABLED=true
EXECUTION_ARTIFACT_ROOT=.execution_artifacts
EXECUTION_DEFAULT_BASE_URL=http://127.0.0.1:5173
EXECUTION_PLAYWRIGHT_CONFIG=backend/execution_runtime/playwright.config.ts
EXECUTION_RUNTIME_CWD=backend/execution_runtime
EXECUTION_MAX_CASES_PER_REQUEST=20
EXECUTION_BROWSER_CHANNEL=msedge

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
# Optional Firebase sign-in provider toggles. Defaults are true when omitted.
VITE_FIREBASE_ENABLE_GOOGLE_AUTH=true
VITE_FIREBASE_ENABLE_MICROSOFT_AUTH=true
VITE_FIREBASE_ENABLE_APPLE_AUTH=true

# Billing / entitlement controls. Shadow mode records usage without hard blocking by default.
BILLING_SHADOW_MODE=true
BILLING_CONTACT_EMAIL=hello@spica-digital.eu
BILLING_PRICING_VERSION=pilot-v1
BILLING_TOKEN_UNIT_SIZE=4
BILLING_PILOT_REQUIREMENTS_LIMIT=200
BILLING_PILOT_TEST_CASE_LIMIT=200
# Optional comma-separated admin emails for billing grant/allocation endpoints.
# BILLING_ADMIN_EMAILS=admin@example.com,finance@example.com
# BILLING_MAX_OVERDRAFT_UNITS=0
# BILLING_LAUNCH_DATE=2026-05-08T00:00:00Z
