GEMINI_API_KEY=your_key_here
MODEL_NAME=gemini-3-flash-preview

# Google Login (backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Optional: comma-separated allow-list for multiple frontend builds/environments.
# GOOGLE_CLIENT_IDS=your_local_client_id.apps.googleusercontent.com,your_prod_client_id.apps.googleusercontent.com
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
