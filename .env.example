GEMINI_API_KEY=your_key_here
MODEL_NAME=gemini-3-flash-preview

# Google Login (backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Optional: comma-separated allow-list for multiple frontend builds/environments.
# GOOGLE_CLIENT_IDS=your_local_client_id.apps.googleusercontent.com,your_prod_client_id.apps.googleusercontent.com
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional for local containerized backend auth or non-GCP runtimes.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional alternative for the deploy helper: absolute path to a local Firebase Admin SDK JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Optional dedicated encryption key for stored per-user JIRA connections.
# If unset, the backend will derive encryption from JWT_SECRET_KEY.
# JIRA_CONNECTION_SECRET_KEY=replace_with_a_different_long_random_secret
# Optional JIRA Cloud client tuning.
# JIRA_API_TIMEOUT_SECONDS=15
# JIRA_PROJECT_PAGE_SIZE=50
# JIRA_ISSUE_PAGE_SIZE=50

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
