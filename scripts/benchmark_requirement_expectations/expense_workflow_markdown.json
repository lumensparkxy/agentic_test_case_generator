    },
    {
      "label": "policy limit validation",
      "keywords": ["policy limit", "prevent submission"]
    },
    {
      "label": "future date validation",
      "keywords": ["validation message", "future"]
    },
    {
      "label": "manager approval restriction",
      "keywords": ["managers", "approve", "submitted status"]
    },
    {
      "label": "rejection reason",
      "keywords": ["rejection reason", "rejecting"]
    },
    {
      "label": "finance csv export",
      "keywords": ["finance administrators", "export", "csv"]
    }
  ],
  "must_exclude_keywords": [
    "src/reports/exporter.py",
    "node_modules",
    "csv export job"
  ]
}